{
  "name": "healthcare_platform_pipeline",
  "email_notifications": {
    "on_success": [
      "eg.asmaaeldaly@gmail.com"
    ],
    "on_failure": [
      "eg.asmaaeldaly@gmail.com"
    ],
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "notification_settings": {
    "no_alert_for_skipped_runs": false,
    "no_alert_for_canceled_runs": false
  },
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "25 0 14 * * ?",
    "timezone_id": "Africa/Cairo",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "dbt_transformations",
      "run_if": "ALL_SUCCESS",
      "dbt_task": {
        "project_directory": "healthcare_dbt",
        "commands": [
          "dbt deps",
          "dbt run --select models/bronze",
          "dbt run --select models/silver",
          "dbt run --select models/gold",
          "dbt test"
        ],
        "schema": "healthcare_platform",
        "warehouse_id": "8e6939a00b090311",
        "catalog": "workspace",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "dbt-default",
      "disabled": false
    },
    {
      "task_key": "train_risk_mode",
      "depends_on": [
        {
          "task_key": "dbt_transformations"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/notebooks/05a_train_risk_model.py",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "anomaly_detection",
      "depends_on": [
        {
          "task_key": "train_risk_mode"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/notebooks/05b_anomaly_detection.py",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "score_patients",
      "depends_on": [
        {
          "task_key": "anomaly_detection"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/notebooks/05c_score_patients.py",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "quality_gates",
      "depends_on": [
        {
          "task_key": "score_patients"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/notebooks/04_data_quality_gates.py",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "alert_on_failure",
      "depends_on": [
        {
          "task_key": "score_patients"
        },
        {
          "task_key": "anomaly_detection"
        },
        {
          "task_key": "quality_gates"
        },
        {
          "task_key": "dbt_transformations"
        },
        {
          "task_key": "train_risk_mode"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/notebooks/05_alert_on_failure.py",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "environment_key": "Default",
      "disabled": false
    }
  ],
  "git_source": {
    "git_url": "https://github.com/egasmaaeldaly-88/healthcare-dbt-project.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "queue": {
    "enabled": true
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": {
        "environment_version": "5"
      }
    },
    {
      "environment_key": "dbt-default",
      "spec": {
        "dependencies": [
          "dbt-databricks>=1.0.0,<2.0.0"
        ],
        "environment_version": "5"
      }
    }
  ],
  "performance_target": "PERFORMANCE_OPTIMIZED"
}